# 目标机型: RTX 4090 (Ada, sm_89)。
# 前置条件: 宿主机需有 NVIDIA 驱动(>= 525)并装好 nvidia-container-toolkit。
# 纯推理不需要 CUDA toolkit, pip 版 torch 会把 CUDA runtime 和 cuDNN 一并装进来,
# 所以这里和 CPU 版共用同一个基础镜像, 只换 torch 的 index-url。
# 若目标机器驱动较老(< 525), 把下面这台 index 换成 cu118 即可。
FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# 镜像不绑定任何用户:运行时用 `--user UID:GID` (或 compose 的 `user:`) 指定。
# HOME 指向 /tmp,HF_HOME / CACHE_DIR 指向 /data,由宿主机挂载的目录承载。
ENV HOME=/tmp \
    HF_HOME=/data/hf \
    CACHE_DIR=/data/cache

ARG APP_DIR=/app
WORKDIR $APP_DIR
COPY ./ ./
RUN python -m venv $APP_DIR/.venv && . $APP_DIR/.venv/bin/activate && \
  pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu126 && \
  pip install --no-cache-dir .

# 任意 UID 都要能读 /app;marker 会把提取的图片写到当前目录,所以 /app 需要可写(sticky)
RUN chmod -R a+rX $APP_DIR && chmod 1777 $APP_DIR && \
  mkdir -p /data && chmod 1777 /data

VOLUME /data
EXPOSE 8080

CMD ["/app/run.sh"]
