ARG CUDA_VERSION="11.8.0"
ARG CUDNN_VERSION="8"
ARG UBUNTU_VERSION="20.04"
ARG MAX_JOBS=4

FROM nvidia/cuda:$CUDA_VERSION-cudnn$CUDNN_VERSION-runtime-ubuntu$UBUNTU_VERSION

ENV DEBIAN_FRONTEND noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common && \
    add-apt-repository -y ppa:deadsnakes/ppa

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    python3.12 \
    wget \
    curl \
    unzip \
    git \
    libgl1 \
    libglib2.0-0 \
    curl \
    gnupg2 \
    ca-certificates \
    apt-transport-https \
    libreoffice \
    ffmpeg \
    git-lfs \
    xvfb

RUN apt-get install -y --no-install-recommends python3.12-venv
# && rm -rf /var/lib/apt/lists/*


# 镜像不绑定任何用户:运行时用 `--user UID:GID` (或 compose 的 `user:`) 指定。
# HOME 指向 /tmp,HF_HOME / CACHE_DIR 指向 /data,由宿主机挂载的目录承载。
ENV HOME=/tmp \
    HF_HOME=/data/hf \
    CACHE_DIR=/data/cache

ARG APP_DIR=/app
WORKDIR $APP_DIR
COPY ./ ./
RUN python3.12 -m venv $APP_DIR/.venv && . $APP_DIR/.venv/bin/activate && \
  pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu118 && \
  pip install --no-cache-dir .

# 任意 UID 都要能读 /app;marker 会把提取的图片写到当前目录,所以 /app 需要可写(sticky)
RUN chmod -R a+rX $APP_DIR && chmod 1777 $APP_DIR && \
  mkdir -p /data && chmod 1777 /data

VOLUME /data
EXPOSE 8080

CMD ["/app/run.sh"]
