# 目标机型: RTX 4090 (Ada, sm_89)。
# 前置条件: 宿主机需有 NVIDIA 驱动(>= 525)并装好 nvidia-container-toolkit。
# 纯推理不需要 CUDA toolkit, pip/uv 版 torch 会把 CUDA runtime 和 cuDNN 一并装进来,
# 所以这里和 CPU 版共用同一个基础镜像, 只换 torch 的 index-url。
# 若目标机器驱动较老(< 525), 把下面这台 index 换成 cu118 即可。
FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    # Triton 首次启动 CUDA kernel 时需要在运行时编译一个 C 辅助模块
    # (triton/backends/nvidia/driver.py -> CudaUtils()), 没有 gcc 会报
    # "RuntimeError: Failed to find C compiler"。slim 镜像不带编译器,必须显式装。
    # --no-install-recommends 下还需显式安装 libc6-dev,提供 stdlib.h 等标准库头文件。
    gcc \
    libc6-dev \
    && rm -rf /var/lib/apt/lists/*

# uv 用官方镜像里的静态二进制,不用装
COPY --from=ghcr.io/astral-sh/uv:0.11.13 /uv /uvx /usr/local/bin/

# 禁止 uv 下载托管版 Python(强制用基础镜像里的 3.12)
ENV UV_PYTHON_DOWNLOADS=never

ARG APP_DIR=/app
WORKDIR $APP_DIR

# 默认走国内镜像(实测更快)。要回官方源:
#   --build-arg TORCH_INDEX=https://download.pytorch.org/whl/cu126
#   --build-arg UV_INDEX=https://pypi.org/simple
# 注意:换 build-arg 值会作废对应层的缓存,选定后保持一致。
ARG TORCH_INDEX="https://mirror.sjtu.edu.cn/pytorch-wheels/cu126"
ARG UV_INDEX="https://mirrors.aliyun.com/pypi/simple"

# ---- 层1: torch(最重,GB 级)----
# 缓存键只有这一行 RUN 本身;改 pyproject 或源码都不会作废这一层。
# wheel 走 BuildKit cache mount:网络中断后重试、层失效后重建,都不必重新下载。
# 构建期 HOME 是 /root,uv 缓存默认就在 /root/.cache/uv。
RUN --mount=type=cache,target=/root/.cache/uv \
  uv venv --seed $APP_DIR/.venv && \
  uv pip install --link-mode=copy --python $APP_DIR/.venv/bin/python \
    torch torchvision torchaudio \
    --index-url $TORCH_INDEX

# ---- 层2: 项目依赖 ----
# 缓存键 = pyproject.toml。poetry 构建要求 README.md 和 marker_api/ 存在,
# 先放占位文件,真实文件由层3 覆盖。
# 用 editable 安装:层3 更新源码后无需重装包本身,直接生效。
COPY pyproject.toml ./
RUN --mount=type=cache,target=/root/.cache/uv \
  mkdir -p marker_api && touch marker_api/__init__.py README.md && \
  uv pip install --link-mode=copy --python $APP_DIR/.venv/bin/python \
    --index-url $UV_INDEX -e .

# ---- 层3: 源码(秒级)----
# 日常改代码只作废从这里开始的层,torch 和依赖层保持缓存。
# 注意:不要在这里对 /app 递归 chmod。.venv 属于下面的缓存层,
# 递归改动会触发 overlayfs copy-up,几万次元数据操作要花几分钟。
# 源码(git 权限)和 venv(构建 umask 022)天然任意 UID 可读,
# 只有 /app 本身需要可写(marker 会把提取的图片写到当前目录)。
COPY ./ ./
RUN chmod 1777 $APP_DIR && \
  mkdir -p /data && chmod 1777 /data

# 镜像不绑定任何用户:运行时用 `--user UID:GID` (或 compose 的 `user:`) 指定。
# HOME 指向 /tmp,HF_HOME / CACHE_DIR 指向 /data,由宿主机挂载的目录承载。
# (ENV 放在所有 RUN 之后,改动它不会作废上面的重层。)
ENV HOME=/tmp \
    HF_HOME=/data/hf \
    CACHE_DIR=/data/cache \
    # Triton 的 kernel JIT 缓存落在 /data(宿主机挂载),容器重启后不必重新编译
    TRITON_CACHE_DIR=/data/cache/triton

# 让 `docker exec <容器> python/pip/uv ...` 直接用 venv 里的工具
ENV VIRTUAL_ENV=/app/.venv
ENV PATH="/app/.venv/bin:$PATH"

VOLUME /data
EXPOSE 8080

CMD ["/app/run.sh"]
